{
  "name": "memora",
  "version": "0.0.0-dev",
  "author": {
    "name": "Timothy Yin",
    "email": "master@uniiem.com"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS=\"--max-old-space-size=8192\" nuxt generate",
    "build:deps": "pnpm --filter @memora/webgl-image build",
    "dev": "run-p dev:dep dev:wait-only",
    "dev:backend": "go -C .. run ./cmd/memora",
    "dev:debug": "run-p dev:backend dev",
    "dev:dep": "pnpm --filter @memora/webgl-image dev",
    "dev:only": "nuxt dev --host 0.0.0.0 --port 3001",
    "dev:wait-only": "wait-on packages/memora-webgl-image/dist && nuxt dev --host 0.0.0.0 --port 3001",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "docs:dev": "vitepress dev ../docs",
    "docs:build": "vitepress build ../docs",
    "docs:preview": "vitepress preview ../docs"
  },
  "dependencies": {
    "@memora/webgl-image": "workspace:*",
    "@iconify/vue": "5.0.1",
    "@indoorequal/vue-maplibre-gl": "^8.4.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.2.3",
    "@nuxt/ui": "^4.8.2",
    "@nuxtjs/i18n": "10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.0",
    "@takumi-rs/core": "2.0.0-rc.16",
    "@unhead/vue": "^2.1.15",
    "@vingle/bmp-js": "^0.2.5",
    "@vueuse/nuxt": "14.3.0",
    "@yeger/vue-masonry-wall": "^6.1.1",
    "dayjs-nuxt": "2.1.11",
    "es-toolkit": "^1.47.0",
    "file-type": "^22.0.1",
    "maplibre-gl": "^5.24.0",
    "motion-v": "^2.3.0",
    "nuxt": "^4.4.8",
    "nuxt-gtag": "4.1.0",
    "nuxt-mapbox": "1.6.4",
    "nuxt-maplibre": "^1.2.2",
    "nuxt-og-image": "6.7.2",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.9",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "thumbhash": "^0.1.1",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4",
    "wait-on": "^9.0.10",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.34.1",
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.23",
    "@iconify-json/fluent-emoji-flat": "^1.2.5",
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/material-symbols": "^1.2.76",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.86",
    "@iconify-json/streamline": "^1.2.5",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/tabler": "^1.2.35",
    "@nuxt/test-utils": "4.0.3",
    "@vueuse/core": "^14.3.0",
    "baseline-browser-mapping": "^2.10.35",
    "consola": "^3.4.2",
    "dayjs": "^1.11.21",
    "mapbox-gl": "^3.24.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.17"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@nuxt/kit"
      ]
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
